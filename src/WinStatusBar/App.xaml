<Application x:Class="WinStatusBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Values are overwritten at runtime by Theme.Apply (light/dark). -->
    <SolidColorBrush x:Key="BarBackground" Color="#202020"/>
    <SolidColorBrush x:Key="BarBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BarText" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BarMuted" Color="#9A9A9A"/>
  </Application.Resources>
</Application>
